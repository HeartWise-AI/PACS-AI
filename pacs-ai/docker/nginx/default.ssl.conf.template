# Access log without patient identifiers: the viewer URL carries patientId and
# StudyInstanceUIDs in its query string, and every asset request repeats it in
# the Referer. Log the requested path only, no query string and no Referer.
map $request_uri $request_path_only {
  "~^(?<path_only>[^?]*)" $path_only;
}
log_format no_query '$remote_addr - $remote_user [$time_local] "$request_method $request_path_only $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent" "$http_x_forwarded_for"';

# Referrer-Policy strict-origin: requests made by the viewer page (API calls,
# DICOMweb, images) carry only "https://<host>/" in the Referer, never the
# viewer path and query string (StudyInstanceUIDs, formerly patientId). The API
# is on the same origin, so strict-origin-when-cross-origin or same-origin would
# still send the full URL to it; no-referrer would also turn the Origin header
# of same-origin POSTs into "null". Nothing on the backend checks the Referer.
server {
  access_log /var/log/nginx/access.log no_query;
  listen ${SSL_PORT} ssl http2 default_server;
  listen [::]:${SSL_PORT} ssl http2 default_server;
  ssl_certificate /etc/ssl/certs/ssl-certificate.crt;
  ssl_certificate_key /etc/ssl/private/ssl-private-key.key;

  location = ${PUBLIC_URL} {
    root /usr/share/nginx/html;
    try_files $uri ${PUBLIC_URL}index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Cloudflare-CDN-Cache-Control "no-store" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Referrer-Policy strict-origin always;
  }

  location = ${PUBLIC_URL}index.html {
    root /usr/share/nginx/html;
    try_files $uri =404;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Cloudflare-CDN-Cache-Control "no-store" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Referrer-Policy strict-origin always;
  }

  location ~* "^${PUBLIC_URL}(app-config\.js|env-config\.js|version\.json|manifest\.json|init-service-worker\.js|sw\.js)$" {
    root /usr/share/nginx/html;
    try_files $uri =404;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Cloudflare-CDN-Cache-Control "no-store" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Referrer-Policy strict-origin always;
  }

  location ~* "\.[0-9a-f]{8,}\.(css|js|mjs|wasm|woff|woff2|ttf|eot|png|jpg|jpeg|gif|svg)$" {
    root /usr/share/nginx/html;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Referrer-Policy strict-origin always;
  }

  location / {
    root   /usr/share/nginx/html;
    index  index.html index.htm;
    try_files $uri $uri/ ${PUBLIC_URL}index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Cloudflare-CDN-Cache-Control "no-store" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Referrer-Policy strict-origin always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }
  error_page   500 502 503 504  /50x.html;
  location = /50x.html {
    root   /usr/share/nginx/html;
    add_header Referrer-Policy strict-origin always;
  }
}

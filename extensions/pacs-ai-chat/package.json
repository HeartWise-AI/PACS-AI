{
  "name": "@pacs-ai/extension-chat",
  "version": "1.0.0",
  "description": "PACS-AI chat assistant: the draggable chat with tool-activity steps, series carousel and citations, and its toolbar button",
  "private": true,
  "license": "MIT",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./citations": "./src/citations.ts"
  },
  "keywords": [
    "ohif-extension"
  ],
  "scripts": {
    "test:unit": "jest --watchAll",
    "test:unit:ci": "jest --ci --runInBand --collectCoverage --passWithNoTests"
  },
  "peerDependencies": {
    "@ohif/app": "3.11.1",
    "@ohif/core": "3.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "12.3.1"
  },
  "dependencies": {
    "@pacs-ai/extension-core": "1.0.0",
    "prop-types": "15.8.1",
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "13.4.0"
  }
}
